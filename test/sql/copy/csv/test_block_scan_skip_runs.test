# LF, rejects of the rows, selecting a
query IIIIII
CREATE OR REPLACE TEMP TABLE t_rej_LF_a AS SELECT a FROM read_csv('{DATA_DIR}/csv/block_scan_runs.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'VARCHAR','e':'VARCHAR','f':'VARCHAR'}, store_rejects=true, rejects_table='rej_LF_a', rejects_scan='scan_rej_LF_a'); SELECT line, line_byte_position, byte_position, column_idx, error_type, replace(replace(csv_line, chr(10), '<LF>'), chr(13), '<CR>') FROM rej_LF_a ORDER BY ALL
----
7	107	114	3	MISSING COLUMNS	7,b7,c7
7	107	114	4	MISSING COLUMNS	7,b7,c7
7	107	114	5	MISSING COLUMNS	7,b7,c7
8	115	131	7	TOO MANY COLUMNS	8,b8,c8,d8,e8,f8,extra

