# name: test/sql/copy/csv/test_block_scan_skip_runs.test
# description: Runs of unprojected columns are skipped by counting their delimiters, results, errors and rejects stay the same
# group: [csv]

# the fixtures depend on exact byte offsets
require notwindows

# block_scan_runs.csv holds, per row, a tab, a quoted value with the delimiter, a quote in an unquoted value, a space
# before a quote, empty values, too few and too many columns, an escaped quote, a run across
# a block edge, delimiters on both sides of a block edge and no newline after the last row. The CRLF file holds the same
# rows, the CR file a lone carriage return, empty_first.csv an empty first value in every row. The wide file has 300
# columns with a quoted value, a short and a long row. Expected results are those of the parent build.

statement ok
COPY (SELECT ',x' || i FROM range(100) t(i)) TO '{TEST_DIR}/empty_first.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

# LF, strict, counting
statement error
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/block_scan_runs.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'VARCHAR','e':'VARCHAR','f':'VARCHAR'})
----
Invalid Input Error: CSV Error on Line: 7

