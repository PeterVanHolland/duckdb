# name: test/sql/copy/csv/test_block_scan_skip_runs_dialects.test
# description: Runs of unprojected columns skipped with one call in multi-byte delimiter, CR, CRLF and comment dialects, results, errors and rejects stay the same as the byte loop's
# group: [csv]

# the fixtures depend on exact byte offsets
require notwindows

# Every block_scan_runs_*.csv holds the rows of block_scan_runs.csv written with the dialect: a tab, a quoted value holding the
# delimiter, a quote in an unquoted value, a space before a quote, empty values, too few and too many columns, an escaped
# quote, a run across a block edge, a partial match of the delimiter inside a value and no newline after the last row;
# the comment files add comment lines, a comment byte inside a value and a comment byte right after a delimiter.
# Expected results are those of the build before the change.

# file pipe2, strict, counting
statement error
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/block_scan_runs_pipe2.csv', delim='||', new_line='\n', quote='"', escape='"', header=false, auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR','d':'VARCHAR','e':'VARCHAR','f':'VARCHAR'})
----
Invalid Input Error: CSV Error on Line: 7

