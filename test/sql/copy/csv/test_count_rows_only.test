# name: test/sql/copy/csv/test_count_rows_only.test
# description: count(*) over a CSV reads no column: row counts, width errors, invalid UTF-8 in the first column, rejects and line numbers stay as they were when the first column was read
# group: [csv]

# the fixtures depend on exact byte offsets
require notwindows

# block_scan_count_rows.csv holds 5,000 rows of three columns without a trailing newline: an invalid byte in the first column of row 2049
# (right after the first chunk of 2,048 rows), too many columns in row 4097 and too few in row 4098; the CRLF twin holds the same rows; the
# col3 file has its invalid byte in the third column, which a count never validates. Expected results are those of the build before the change.
# block_scan_count_rows_crlf_edge.csv holds 188 CRLF rows with width errors in rows 1, 5 and 62 to 65; its carriage returns fall on every byte
# of a 64 byte block, the last one included. block_scan_count_rows_comment.csv holds 2,100 rows with comment lines at rows 65, 2049 and 2100
# and a comment starting inside the last value of row 901; with a 100 byte buffer that value and the comment line at the chunk boundary span
# buffer edges.
# block_scan_count_rows_crlf_full.csv holds 2,048 CRLF rows of `a,b`, one oversized row and 50 more; block_scan_count_rows_quoted_newline.csv
# holds a 64 byte row with a quoted newline and too many columns, then 500 plain rows; block_scan_count_rows_backslash.csv holds three rows
# whose quoted first value is an escaped two byte character (0xC3, a backslash, 0xA9).
# block_scan_count_rows_crlf_split.csv is one row of 63 bytes and a CRLF, which a 64 byte buffer splits; the surplus files hold one row of
# 60 bytes, a second value and two surplus fields, empty in one file and `x` in the other, their first delimiter at byte 60 of the block.
# block_scan_count_rows_quoted_crlf_split.csv (129 bytes) holds single column CRLF rows with a stray quote, invalid bytes, escaped quotes and
# an empty last line, read with a 128 byte buffer so the last rows are stitched together over the buffer edge.

statement ok
COPY (SELECT * FROM (VALUES ('a'), (''), ('b'), (''), ('c')) t(x)) TO '{TEST_DIR}/count_single_empty.csv' (FORMAT CSV, HEADER false, QUOTE '', ESCAPE '');

# an invalid byte in the first column at row 2049, width errors at rows 4097 and 4098, strict
statement error
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/block_scan_count_rows.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR'})
----
Invalid Input Error: CSV Error on Line: 2049

# ignore_errors
query I
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/block_scan_count_rows.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR'}, ignore_errors=true)
----
4997

# null_padding and ignore_errors
query I
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/block_scan_count_rows.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR'}, ignore_errors=true, null_padding=true)
----
4998

# null_padding, strict
statement error
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/block_scan_count_rows.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR'}, null_padding=true)
----
Invalid Input Error: CSV Error on Line: 2049

# rejects
statement ok
CREATE OR REPLACE TEMP TABLE r_count AS SELECT count(*) AS c FROM read_csv('{DATA_DIR}/csv/block_scan_count_rows.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'INTEGER','b':'VARCHAR','c':'VARCHAR'}, store_rejects=true, rejects_table='rej_count', rejects_scan='scan_count')

query I
SELECT c FROM r_count
----
4997

query III
SELECT line, column_idx, error_type FROM rej_count ORDER BY ALL
----
2049	1	INVALID ENCODING
4097	4	TOO MANY COLUMNS
4098	2	MISSING COLUMNS

