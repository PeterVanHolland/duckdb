# name: test/sql/copy/csv/test_count_rows_only_utf8.test
# description: count(*) over a CSV file with non ASCII bytes validates the first column only
# group: [csv]

# The fixtures have 2,200 rows of three columns. The second and third column hold non ASCII text in nearly every
# 64 byte block, an invalid byte (every 97th row) and a truncated sequence at the row end (every 101st), which a
# count does not validate. The first column is a number, a valid non ASCII value (every 53rd row), empty (every
# 211th) or longer than a block (every 167th); the invalid files add an invalid first column at rows 300, 1100,
# 2049, 2050 and 2200. Expected results are those of the build that reads the first column to count.

# LF, strict
query I
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/block_scan_count_rows_utf8.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'VARCHAR','b':'VARCHAR','c':'VARCHAR'})
----
2200

# LF, parallel=false
query I
SELECT count(*) FROM read_csv('{DATA_DIR}/csv/block_scan_count_rows_utf8.csv', delim=',', quote='"', escape='"', header=false, new_line='\n', auto_detect=false, columns={'a':'VARCHAR','b':'VARCHAR','c':'VARCHAR'}, parallel=false)
----
2200

