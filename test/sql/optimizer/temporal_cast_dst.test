# name: test/sql/optimizer/temporal_cast_dst.test
# description: Test temporal cast filter pushdown around DST boundaries
# group: [optimizer]

require icu

statement ok
SET timezone='Europe/Paris';

# Create a table spanning the autumn DST switch (2026-10-25, clocks go back at 3:00 -> 2:00)
# This creates 10 hours of TIMESTAMPTZ data in 1-minute intervals around the switch
# We need enough data so that the relaxed filter bounds (with 2h margin) are not trivially true,
# otherwise the statistics propagator will remove them.
statement ok
CREATE TABLE dst_table AS
    SELECT '2026-10-25 00:00:00+02'::TIMESTAMPTZ + (i * INTERVAL '1 minute') AS col
    FROM range(600) t(i);

# ---------------------------------------------------------------------------
# TIMESTAMPTZ -> TIMESTAMP around DST boundary
# The cast to TIMESTAMP creates ambiguity: two different TIMESTAMPTZ values
# (pre- and post-switch) map to the same TIMESTAMP value.
# The relaxed filter must not miss any rows.
# ---------------------------------------------------------------------------
query II
EXPLAIN SELECT * FROM dst_table WHERE CAST(col AS TIMESTAMP) > '2026-10-25 02:30:00'::TIMESTAMP;
----
physical_plan	<REGEX>:.*optional.*col.*

query II
EXPLAIN SELECT * FROM dst_table WHERE CAST(col AS TIMESTAMP) <= '2026-10-25 02:30:00'::TIMESTAMP;
----
physical_plan	<REGEX>:.*optional.*col.*

# Correctness: the two halves must add up to the full table (no rows lost)
query I
SELECT (SELECT count(*) FROM dst_table WHERE CAST(col AS TIMESTAMP) > '2026-10-25 02:30:00'::TIMESTAMP)
     + (SELECT count(*) FROM dst_table WHERE CAST(col AS TIMESTAMP) <= '2026-10-25 02:30:00'::TIMESTAMP);
----
600

# ---------------------------------------------------------------------------
# TIMESTAMP -> TIMESTAMPTZ around DST boundary
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE ts_dst_table AS
    SELECT ('2026-10-25 00:00:00'::TIMESTAMP + (i * INTERVAL '1 minute')) AS col
    FROM range(300) t(i);

query II
EXPLAIN SELECT * FROM ts_dst_table WHERE CAST(col AS TIMESTAMPTZ) > '2026-10-25 02:30:00+01'::TIMESTAMPTZ;
----
physical_plan	<REGEX>:.*optional.*col.*

# Correctness: the two halves must add up to the full table
query I
SELECT (SELECT count(*) FROM ts_dst_table WHERE CAST(col AS TIMESTAMPTZ) > '2026-10-25 02:30:00+01'::TIMESTAMPTZ)
     + (SELECT count(*) FROM ts_dst_table WHERE CAST(col AS TIMESTAMPTZ) <= '2026-10-25 02:30:00+01'::TIMESTAMPTZ);
----
300

# ---------------------------------------------------------------------------
# TIMESTAMPTZ -> DATE on the 25 hour day of the autumn switch
# The rows lie in the last hour of the local day, after local midnight plus 24 hours.
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE long_day AS
    SELECT '2026-10-25 22:00:30+00'::TIMESTAMPTZ + (i * INTERVAL '1 minute') AS col
    FROM range(60) t(i);

query I
SELECT count(*) FROM long_day WHERE CAST(col AS DATE) = DATE '2026-10-25';
----
60

query I
SELECT count(*) FROM long_day WHERE CAST(col AS DATE) <= DATE '2026-10-25';
----
60

query I
SELECT count(*) FROM long_day WHERE CAST(col AS DATE) >= DATE '2026-10-26';
----
0

statement ok
CREATE TABLE long_day_ns AS SELECT col::TIMESTAMPTZ_NS AS col FROM long_day;

query I
SELECT count(*) FROM long_day_ns WHERE CAST(col AS DATE) = DATE '2026-10-25';
----
60

query I
SELECT count(*) FROM long_day_ns WHERE CAST(col AS DATE) <= DATE '2026-10-25';
----
60

query I
SELECT count(*) FROM long_day WHERE CAST(col AS DATE) >= DATE '2026-10-25';
----
60

query I
SELECT count(*) FROM long_day WHERE CAST(col AS DATE) > DATE '2026-10-24';
----
60

query I
SELECT count(*) FROM long_day WHERE DATE '2026-10-25' = CAST(col AS DATE);
----
60

query I
SELECT count(*) FROM long_day_ns WHERE CAST(col AS DATE) >= DATE '2026-10-25';
----
60

query I
SELECT count(*) FROM long_day WHERE CAST(col AS DATE) < DATE '2026-10-26';
----
60

query I
SELECT count(*) FROM long_day_ns WHERE CAST(col AS DATE) > DATE '2026-10-24';
----
60

# ---------------------------------------------------------------------------
# TIMESTAMPTZ_NS -> TIMESTAMP and TIMESTAMPTZ -> TIMESTAMP_MS around the autumn switch
# 02:30 happens twice, each single row table holds one of the instants, and the relaxed filter must keep both
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE first_ns AS SELECT '2026-10-25 00:30:00+00'::TIMESTAMPTZ_NS AS col;

statement ok
CREATE TABLE second_ns AS SELECT '2026-10-25 01:30:00+00'::TIMESTAMPTZ_NS AS col;

query II
SELECT (SELECT count(*) FROM first_ns WHERE CAST(col AS TIMESTAMP) > TIMESTAMP '2026-10-25 02:15:00'),
    (SELECT count(*) FROM second_ns WHERE CAST(col AS TIMESTAMP) > TIMESTAMP '2026-10-25 02:15:00');
----
1	1

query II
SELECT (SELECT count(*) FROM first_ns WHERE CAST(col AS TIMESTAMP) < TIMESTAMP '2026-10-25 02:45:00'),
    (SELECT count(*) FROM second_ns WHERE CAST(col AS TIMESTAMP) < TIMESTAMP '2026-10-25 02:45:00');
----
1	1

statement ok
CREATE TABLE first_us AS SELECT '2026-10-25 00:30:00+00'::TIMESTAMPTZ AS col;

statement ok
CREATE TABLE second_us AS SELECT '2026-10-25 01:30:00+00'::TIMESTAMPTZ AS col;

query II
SELECT (SELECT count(*) FROM first_us WHERE CAST(col AS TIMESTAMP_MS) > TIMESTAMP_MS '2026-10-25 02:15:00'),
    (SELECT count(*) FROM second_us WHERE CAST(col AS TIMESTAMP_MS) > TIMESTAMP_MS '2026-10-25 02:15:00');
----
1	1

query II
SELECT (SELECT count(*) FROM first_us WHERE CAST(col AS TIMESTAMP_MS) < TIMESTAMP_MS '2026-10-25 02:45:00'),
    (SELECT count(*) FROM second_us WHERE CAST(col AS TIMESTAMP_MS) < TIMESTAMP_MS '2026-10-25 02:45:00');
----
1	1

query II
SELECT (SELECT count(*) FROM first_ns WHERE CAST(col AS TIMESTAMP_MS) > TIMESTAMP_MS '2026-10-25 02:15:00'),
    (SELECT count(*) FROM second_ns WHERE CAST(col AS TIMESTAMP_MS) < TIMESTAMP_MS '2026-10-25 02:45:00');
----
1	1

query II
SELECT (SELECT count(*) FROM first_us WHERE CAST(col AS TIMESTAMP_S) > TIMESTAMP_S '2026-10-25 02:15:00'),
    (SELECT count(*) FROM second_us WHERE CAST(col AS TIMESTAMP_S) < TIMESTAMP_S '2026-10-25 02:45:00');
----
1	1
