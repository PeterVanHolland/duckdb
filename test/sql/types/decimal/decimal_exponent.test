# name: test/sql/types/decimal/decimal_exponent.test
# description: Test casting from varchar to decimal (exponents)
# group: [decimal]

# standard exponents
query IIII
SELECT '1e3'::DECIMAL, '1e-1'::DECIMAL, '.1e3'::DECIMAL, '0.1e3'::DECIMAL
----
1000.000	0.1	100.000	100.000

# negative numbers
query IIII
SELECT '-1e3'::DECIMAL, '-0.1e3'::DECIMAL, '-.1e-1'::DECIMAL, '-0.1e-1'::DECIMAL
----
-1000	-100	-0.01	-0.01

# zero
query IIII
SELECT '0e1'::DECIMAL, '-0e1'::DECIMAL, '00000e1'::DECIMAL, '-00000e1'::DECIMAL
----
0	0	0	0

# not enough precision: just truncated to 0
query I
SELECT '1e-100'::DECIMAL
----
0

# large negative exponent
query I
SELECT '1e-9999'::DECIMAL
----
0

# different decimal precisions
query I
SELECT '1E3'::DECIMAL(4,0)
----
1000

query I
SELECT '1e8'::DECIMAL(9,0)
----
100000000

query I
SELECT '1e17'::DECIMAL(18,0)
----
100000000000000000

query I
SELECT '1e37'::DECIMAL(38,0)
----
10000000000000000000000000000000000000

statement error
SELECT '1e4'::DECIMAL(4,0)
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1e9'::DECIMAL(9,0)
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1e18'::DECIMAL(18,0)
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1e38'::DECIMAL(38,0)
----
<REGEX>:Conversion Error.*Could not convert string.*

# overflow
statement error
SELECT '1e100'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

# multiple exponents
statement error
SELECT '1e100e100'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

# fractional exponent
statement error
SELECT '1e100.2'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

# very large exponents
statement error
SELECT '1e9999999999'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1e-9999999999'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1e-99999999999999999999999999999999'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

# not an exponent
statement error
SELECT '.1f3'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

statement error
SELECT '1f3'::DECIMAL
----
<REGEX>:Conversion Error.*Could not convert string.*

# large negative exponent with mantissa >= 5 should truncate to 0, not round up (issue #23768)
query I
SELECT '5.8207660913467407e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '5.5e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '4.9e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '9.9e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '5e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '1e-10'::DECIMAL(18,4)
----
0.0000

# negative mantissa with large negative exponent
query I
SELECT '-5.5e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '-9.9e-11'::DECIMAL(18,4)
----
0.0000

query I
SELECT '-5e-11'::DECIMAL(18,4)
----
0.0000

# large negative exponent with higher precision scale
query I
SELECT '5.5e-11'::DECIMAL(18,10)
----
0.0000000001

query I
SELECT '4.9e-11'::DECIMAL(18,10)
----
0.0000000000

query I
SELECT '5.5e-12'::DECIMAL(18,10)
----
0.0000000000

# rounding at the boundary: exponent close to scale should still round correctly
query I
SELECT '5e-4'::DECIMAL(18,4)
----
0.0005

query I
SELECT '5e-5'::DECIMAL(18,4)
----
0.0001

query I
SELECT '4.9e-5'::DECIMAL(18,4)
----
0.0000

query I
SELECT '5.5e-5'::DECIMAL(18,4)
----
0.0001

# default DECIMAL precision (18,3) with large negative exponent
query I
SELECT '5.5e-10'::DECIMAL
----
0.000

query I
SELECT '9.9e-10'::DECIMAL
----
0.000

# large negative exponent with varying DECIMAL scales
query I
SELECT '5.5e-6'::DECIMAL(18,6)
----
0.000006

query I
SELECT '5.5e-7'::DECIMAL(18,6)
----
0.000001

query I
SELECT '5.5e-8'::DECIMAL(18,6)
----
0.000000

# decimals that a positive exponent moves before the decimal point count towards the width
statement error
SELECT '0.2e5'::DECIMAL(4,0)
----
Conversion Error

statement error
SELECT '-0.2e5'::DECIMAL(4,0)
----
Conversion Error

statement error
SELECT '218.91127e7'::DECIMAL(10,2)
----
Conversion Error

statement error
SELECT '0.12345e4'::DECIMAL(4,1)
----
Conversion Error

statement error
SELECT '0.99e38'::DECIMAL(37,0)
----
Conversion Error

query III
SELECT TRY_CAST('0.92e19' AS DECIMAL(17,0)), TRY_CAST('0.92e19' AS DECIMAL(18,0)), TRY_CAST('0.92e19' AS DECIMAL(19,0))
----
NULL	NULL	9200000000000000000

query IIIIII
SELECT '0.2e4'::DECIMAL(4,0), '-0.2e4'::DECIMAL(4,0), '0.9999e4'::DECIMAL(4,0), '0.1234e3'::DECIMAL(4,1), '218.91127e7'::DECIMAL(12,2), '0.99e38'::DECIMAL(38,0)
----
2000	-2000	9999	123.4	2189112700.00	99000000000000000000000000000000000000

# leading zeros after decimal point should not exhaust storage width before exponent shifts digits
query IIII
SELECT '0.0000000001234e10'::DECIMAL(5,2), '0.000000000123456e12'::DECIMAL(9,2), '0.000000000000000000123e20'::DECIMAL(18,2), '0.000000000000000000123e20'::DECIMAL(19,2)
----
1.23	123.46	12.30	12.30

query IIII
SELECT '0.000001234e6'::DECIMAL(4,2), '-0.000001234e6'::DECIMAL(4,2), '0.000001235e6'::DECIMAL(4,2), '-0.000001235e6'::DECIMAL(4,2)
----
1.23	-1.23	1.24	-1.24

query IIIII
SELECT '0.0000000001e10'::DECIMAL(5,2), '0.0000000001e10'::DECIMAL(3,2), '0.01e2'::DECIMAL(3,2), '0.00000123e6'::DECIMAL(6,5), '0.00000000055e8'::DECIMAL(5,2)
----
1.00	1.00	1.00	1.23000	0.06

query IIII
SELECT '0.0000000001234567898e10'::DECIMAL(5,2), '0.0000000001234567898e19'::DECIMAL(18,2), '1.0000000002e5'::DECIMAL(18,2), '1.0000000006e10'::DECIMAL(18,2)
----
1.23	1234567898.00	100000.00	10000000006.00

query III
SELECT '0.000000000000000000123e5'::DECIMAL(5,2), '0.000000000000000000123e-5'::DECIMAL(5,2), '0.000000000000000000123'::DECIMAL(5,2)
----
0.00	0.00	0.00

query II
SELECT '0.001'::DECIMAL(5,3), '-0.001'::DECIMAL(5,3)
----
0.001	-0.001

statement error
SELECT '0.32769e3'::DECIMAL(4,2)
----
Conversion Error

statement error
SELECT '-0.32769e3'::DECIMAL(4,2)
----
Conversion Error

statement error
SELECT '0.000000000123e13'::DECIMAL(4,2)
----
Conversion Error

statement error
SELECT '-0.000000000123e13'::DECIMAL(4,2)
----
Conversion Error

query I
SELECT TRY_CAST('0.000000000123e13' AS DECIMAL(4,2))
----
NULL

query II
SELECT '1.25e3'::DECIMAL(5,1), '-1.70141e36'::DECIMAL(38,1)
----
1250.0	-1701410000000000000000000000000000000.0

query IIII
SELECT TRY_CAST('1.25e4' AS DECIMAL(5,1)), TRY_CAST('1.5e9' AS DECIMAL(9,0)), TRY_CAST('-1.7e38' AS DECIMAL(38,0)),
	TRY_CAST('-1.70141e+37' AS DECIMAL(38,1))
----
NULL	NULL	NULL	NULL

# zeros that the exponent moves before the point leave room for the integer digits
query IIII
SELECT '0.01e3'::DECIMAL(4,2), '-0.01e3'::DECIMAL(4,2), '0.01e7'::DECIMAL(9,3), '0.01e2'::DECIMAL(38,37)
----
10.00	-10.00	100000.000	1.0000000000000000000000000000000000000

# digits after leading zeros of the decimals are kept for the exponent
query III
SELECT '0.00019e1'::DECIMAL(4,4), '-0.00019e1'::DECIMAL(4,4),
	'0.00000000000000000000000000000000000012345e40'::DECIMAL(38,10)
----
.0019	-.0019	1234.5000000000

query II
SELECT ('0.' || repeat('0', 254) || '1e255')::DECIMAL(38,2), ('0.' || repeat('0', 256) || '5')::DECIMAL(18,3)
----
1.00	0.000

# the first decimal that does not fit the result rounds it
query IIII
SELECT '843.09e1'::DECIMAL(4,0), '-843.09e1'::DECIMAL(4,0), '843.049e1'::DECIMAL(4,0),
	'1.00000000000000000000000000000000000005e36'::DECIMAL(38,1)
----
8431	-8431	8430	1000000000000000000000000000000000000.1

query III
SELECT TRY_CAST('0.99995e1' AS DECIMAL(4,3)), TRY_CAST('0.099995e1' AS DECIMAL(4,4)),
	TRY_CAST('-0.099995e1' AS DECIMAL(4,4))
----
NULL	NULL	NULL

query III
SELECT '31234567.85e1'::DECIMAL(9,0), '92233720368547758.15e1'::DECIMAL(18,0),
	'-9.00000000000000000000000000000000000005e36'::DECIMAL(38,1)
----
312345679	922337203685477582	-9000000000000000000000000000000000000.1

# widths beyond 38 digits follow the same rules
query IIIII
SELECT '0.01e3'::DECIMAL(40,2), '-0.01e3'::DECIMAL(40,2), '843.09e1'::DECIMAL(40,0), '-843.09e1'::DECIMAL(40,0),
	'843.049e1'::DECIMAL(40,0)
----
10.00	-10.00	8431	-8431	8430

query III
SELECT '0.00019e1'::DECIMAL(40,4), ('0.' || repeat('0', 50) || '12345e54')::DECIMAL(45,10),
	('0.' || repeat('0', 254) || '1e255')::DECIMAL(40,2)
----
0.0019	1234.5000000000	1.00

query II
SELECT TRY_CAST(('0.' || repeat('9', 40) || '5e1') AS DECIMAL(40,39)), TRY_CAST('1e40' AS DECIMAL(40,0))
----
NULL	NULL
